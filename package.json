{
  "name": "qtr-ecs-validation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "description": "ECS Validation Platform: QTR CAST Method prototype (synthetic data only)",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "preview": "vinext preview",
    "predeploy": "node scripts/pre-deploy.js",
    "deploy": "vinext deploy",

    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",

    "typecheck": "tsc --noEmit",

    "test": "vitest run",
    "test:domain": "vitest run src/domain",
    "test:api": "vitest run src/api",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",

    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ecs-validation --local",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset:local": "tsx scripts/reset-local.ts",

    "audit": "npm audit --production --audit-level=moderate",
    "audit:all": "npm audit",
    "audit:fix": "npm audit fix --production",
    "verify:sharp": "node scripts/verify-sharp-integrity.js",
    "postinstall": "npm run verify:sharp",
    "security:check": "npm run audit && npm run typecheck && npm run lint",
    "verify:integrity": "npm ls --production && npm audit --production",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run security:check && npm run build && npm run e2e"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.7.5",
    "lucide-react": "^0.540.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.0.0",
    "tinypool": "^2.1.2",
    "vinext": "0.x.x",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
